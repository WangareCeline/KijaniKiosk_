# This file documents the shape of the kk-payments-secrets Secret.
# It is safe to commit because it contains no real values.
# The actual Secret is created imperatively — see k8s/README.md.
apiVersion: v1
kind: Secret
metadata:
  name: kk-payments-secrets
  namespace: kijani-project
type: Opaque
stringData:
  DB_PASSWORD: "<replace-with-actual-value>"
  STRIPE_API_KEY: "<replace-with-actual-value>"
  JWT_SECRET: "<replace-with-actual-value>"
